<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Panel List -->
    <record id="view_elc_panel_list" model="ir.ui.view">
        <field name="name">elc.panel.list</field>
        <field name="model">elc.panel</field>
        <field name="arch" type="xml">
            <list string="Electrical Panels">
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Panel Form -->
    <record id="view_elc_panel_form" model="ir.ui.view">
        <field name="name">elc.panel.form</field>
        <field name="model">elc.panel</field>
        <field name="arch" type="xml">
            <form string="Electrical Panel">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Panel Name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <!-- <notebook>
                        <page string="Outgoing Cables">
                            <field name="outgoing_cable_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="to_panel_id"/>
                                    <field name="destination_box"/>
                                    <field name="size_display"/>
                                </list>
                            </field>
                        </page>

                        <page string="Incoming Cables">
                            <field name="incoming_cable_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="from_panel_id"/>
                                    <field name="destination_box"/>
                                    <field name="size_display"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook> -->
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_elc_panels" model="ir.actions.act_window">
        <field name="name">Electrical Panels</field>
        <field name="res_model">elc.panel</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>